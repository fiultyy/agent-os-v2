LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash
GATEWAY_PORT=8000
ORCHESTRATOR_PORT=8001

# ── Auth (set AUTH_ENABLED=true to activate) ──────────────────────────────────
AUTH_ENABLED=false
AUTH_API_KEYS=key-one,key-two,key-three
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
SERVICE_AUTH_KEY=

# ── Embedding provider(可选;不设则默认本地 sentence-transformers,需 torch) ────
# 范例:本地 LM Studio(OpenAI 兼容)。启动 LM Studio → 加载 embedding 模型 → 开 server(16666)
# EMBEDDING_PROVIDER=api
# EMBEDDING_BASE_URL=http://127.0.0.1:16666/v1
# EMBEDDING_API_KEY=lm-studio
# EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# EMBEDDING_DIMENSIONS=0
